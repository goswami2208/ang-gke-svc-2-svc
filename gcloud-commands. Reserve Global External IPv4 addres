gcloud compute url-maps import http-to-https-redirect \
  --source=http-redirect.yaml \
  --global

gcloud compute target-http-proxies create app-http-proxy \
  --url-map=http-to-https-redirect

gcloud compute forwarding-rules create app-http-fw-rule \
  --load-balancing-scheme=EXTERNAL_MANAGED \
  --network-tier=PREMIUM \
  --address=app-lb-ip \
  --target-http-proxy=app-http-proxy \
  --global \
  --ports=80